generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SuperAdmin
  TenantAdmin
  User

  @@map("user_role")
}

enum UserStatus {
  pending_first_login
  active
  suspended

  @@map("user_status")
}

enum TenantStatus {
  pending
  active
  suspended

  @@map("tenant_status")
}

enum OtpChannel {
  email
  sms

  @@map("otp_channel")
}

enum OtpPurpose {
  login
  first_login  @map("first-login")
  signup_rep   @map("signup-rep")
  recover
  invitation

  @@map("otp_purpose")
}

enum DraftStatus {
  draft
  otp_pending
  otp_verified
  payment_pending
  payment_confirmed
  completed
  expired
  abandoned

  @@map("draft_status")
}

enum DraftStep {
  product
  plan
  representative
  otp
  company
  payment
  summary

  @@map("draft_step")
}

enum PaymentStatus {
  pending
  in_review
  approved
  declined
  cancelled
  reversed

  @@map("payment_status")
}

enum PaymentMethod {
  bancard
  bank_transfer

  @@map("payment_method")
}

enum PaymentSettlementKind {
  gateway_webhook
  agent_review
  manual_admin

  @@map("payment_settlement_kind")
}

enum DocumentType {
  invoice
  contract
  receipt

  @@map("document_type")
}

enum DocumentStatus {
  pending
  ready
  failed

  @@map("document_status")
}

enum WebhookSource {
  bancard

  @@map("webhook_source")
}

enum PlanChangeRequestStatus {
  pending
  reviewed

  @@map("plan_change_request_status")
}

enum ResourceType {
  deepseek_tokens
  fal_images
  chat_sessions

  @@map("resource_type")
}

enum QuotaPeriod {
  month
  day
  unlimited

  @@map("quota_period")
}

enum EntitlementSource {
  plan
  override
  trial
  admin

  @@map("entitlement_source")
}

// PR3 (a3) negative-override amendment (owner-confirmed #1675): grant is an
// additive Entitlement (adds access), revoke suppresses plan-derived access
// for the same (tenant, product, module). Resolver = (plan ∪ grant) − revoke.
enum EntitlementKind {
  grant
  revoke

  @@map("entitlement_kind")
}

// ============================================================
// CORE TABLES — public schema
// ============================================================

// Billing boundary (owner decision #5): a Product is the unit customers
// subscribe to. "instagram-dashboard" is the only product today.
model Product {
  id          String   @id
  name        String
  description String?
  active      Boolean  @default(true)
  billingRef  String?  @map("billing_ref")
  trialEnabled      Boolean @default(true) @map("trial_enabled")
  trialDurationDays Int     @default(14)  @map("trial_duration_days")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modules       Module[]
  plans         Plan[]
  subscriptions TenantProductSubscription[]
  entitlements  Entitlement[]
  productRoles  ProductRole[]
  drafts        OnboardingDraft[]

  @@map("products")
}

model Plan {
  id              String   @id
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  currency        String   @db.VarChar(3)
  billingInterval String   @map("billing_interval")
  maxUsers        Int      @map("max_users")
  features        Json     @default("{}")
  popular         Boolean  @default(false)
  active          Boolean  @default(true)
  // Backoffice drag-and-drop order. Lower comes first; ties fall back to
  // createdAt so a fresh plan lands at the end deterministically.
  displayOrder    Int      @default(0) @map("display_order")
  // The plan pre-selected in onboarding and used as the fallback when a draft
  // has none. At most one per product (enforced in PlanRepository.update).
  isDefault       Boolean  @default(false) @map("is_default")
  // Nullable for phase a1 (additive migration); backfilled in a2, tightened to
  // NOT NULL in a follow-up migration once verified (see design Migration/Rollout).
  productId       String?  @map("product_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product       Product?                     @relation(fields: [productId], references: [id])
  tenants       Tenant[]
  drafts        OnboardingDraft[]
  planModules   PlanModule[]
  quotas        PlanQuota[]
  subscriptions TenantProductSubscription[]

  @@map("plans")
}

model PlanQuota {
  id           String       @id @default(uuid()) @db.Uuid
  planId       String       @map("plan_id")
  resourceType ResourceType @map("resource_type")
  limit        Int
  period       QuotaPeriod  @default(month)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, resourceType])
  @@map("plan_quotas")
}

model Tenant {
  id         String       @id @default(uuid()) @db.Uuid
  slug       String       @unique @db.VarChar(40)
  name       String       @db.VarChar(200)
  legalName  String?      @map("legal_name") @db.VarChar(200)
  ruc        String?      @db.VarChar(20)
  address    String?      @db.VarChar(300)
  city       String?      @db.VarChar(100)
  country    String?      @db.VarChar(3)
  phone      String?      @db.VarChar(20)
  schemaName String       @unique @map("schema_name") @db.VarChar(60)
  planId     String       @map("plan_id")
  status     TenantStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  plan               Plan              @relation(fields: [planId], references: [id])
  users              User[]
  payments           Payment[]
  documents          Document[]
  invitations        Invitation[]
  drafts             OnboardingDraft[]
  planChangeRequests PlanChangeRequest[]
  moduleOverrides    TenantModuleOverride[]
  productSubscriptions TenantProductSubscription[]
  entitlements         Entitlement[]

  @@index([planId])
  @@map("tenants")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  email               String     @db.VarChar(254)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  role                UserRole
  fullName            String?    @map("full_name") @db.VarChar(200)
  phone               String?    @map("phone") @db.VarChar(20)
  picture             String?    @db.VarChar(500)
  status              UserStatus @default(pending_first_login)
  failedLoginAttempts       Int        @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?  @map("locked_until")
  activationTokenHash       String?    @unique @map("activation_token_hash") @db.VarChar(64)
  activationTokenExpiresAt  DateTime?  @map("activation_token_expires_at")
  activationTokenUsed       Boolean    @default(false) @map("activation_token_used")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")
  deletedAt                 DateTime?  @map("deleted_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  refreshTokens       RefreshToken[]
  deviceTrusts        DeviceTrust[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  planChangeRequests  PlanChangeRequest[]  @relation("PlanChangeRequests")
  productRoleAssignments UserProductRole[]

  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  familyId  String    @map("family_id") @db.VarChar(32)
  parentId  String?   @map("parent_id") @db.Uuid
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("TokenRotation", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children RefreshToken[] @relation("TokenRotation")

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model DeviceTrust {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceHash String   @map("device_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([expiresAt])
  @@map("device_trusts")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  identifier  String     @db.VarChar(254)
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.VarChar(60)
  attempts    Int        @default(0)
  used        Boolean    @default(false)
  lockedUntil DateTime?  @map("locked_until")
  expiresAt   DateTime   @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([identifier, purpose, used, expiresAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model OnboardingDraft {
  id                   String      @id @default(uuid()) @db.Uuid
  status               DraftStatus @default(draft)
  currentStep          DraftStep   @default(product) @map("current_step")
  version              Int         @default(0)
  planId               String?     @map("plan_id")
  productId            String?     @map("product_id")
  data                 Json        @default("{}")
  representativeEmail  String?     @map("representative_email") @db.VarChar(254)
  resumeTokenHash      String?     @unique @map("resume_token_hash") @db.VarChar(64)
  resumeTokenExpiresAt DateTime?   @map("resume_token_expires_at")
  resumeTokenUsed      Boolean     @default(false) @map("resume_token_used")
  tenantId             String?     @map("tenant_id") @db.Uuid
  expiresAt            DateTime    @map("expires_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  plan     Plan?     @relation(fields: [planId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@index([status, expiresAt])
  @@index([representativeEmail])
  @@map("onboarding_drafts")
}

model Payment {
  id             String                  @id @default(uuid()) @db.Uuid
  draftId        String                  @map("draft_id") @db.Uuid
  tenantId       String?                 @map("tenant_id") @db.Uuid
  externalRef    String                  @unique @map("external_ref") @db.VarChar(100)
  method         PaymentMethod           @default(bancard)
  amount         Decimal                 @db.Decimal(12, 2)
  currency       String                  @default("PYG") @db.VarChar(3)
  status         PaymentStatus           @default(pending)
  reason         String?                 @db.VarChar(200)
  settlementKind PaymentSettlementKind?  @map("settlement_kind")
  settledBy      String?                 @map("settled_by") @db.Uuid
  settledAt      DateTime?               @map("settled_at")
  note           String?                 @db.VarChar(500)
  initiatedAt    DateTime                @default(now()) @map("initiated_at")
  confirmedAt    DateTime?               @map("confirmed_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  draft  OnboardingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  tenant Tenant?         @relation(fields: [tenantId], references: [id])

  @@index([draftId, initiatedAt])
  @@map("payments")
}

// Backoffice-toggleable payment methods (owner correction, tasks phase):
// bootstrap rows are seeded in the migration SQL, not only db/seed.ts, since
// `docker-entrypoint` runs `db:migrate:deploy` (not seed) in some environments.
model PaymentMethodConfig {
  method      PaymentMethod @id
  enabled     Boolean       @default(true)
  displayName String        @map("display_name") @db.VarChar(100)
  config      Json          @default("{}")
  updatedBy   String?       @map("updated_by") @db.Uuid
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("payment_method_configs")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  source      WebhookSource
  processId   String        @map("process_id") @db.VarChar(100)
  status      String        @db.VarChar(40)
  rawBody     Json          @map("raw_body")
  processedAt DateTime      @default(now()) @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([processId, status])
  @@index([source, processedAt])
  @@map("webhook_events")
}

model IdempotencyRecord {
  key             String   @id @db.Uuid
  requestHash     String   @map("request_hash") @db.VarChar(64)
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body")
  responseHeaders Json?    @map("response_headers")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}

model Invitation {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @db.VarChar(254)
  tenantId      String    @map("tenant_id") @db.Uuid
  inviterUserId String?   @map("inviter_user_id") @db.Uuid
  role          UserRole  @default(User)
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  usedAt        DateTime? @map("used_at")
  revokedAt     DateTime? @map("revoked_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  inviter User?  @relation("InvitationInviter", fields: [inviterUserId], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  type       DocumentType
  storageKey String         @map("storage_key") @db.VarChar(500)
  status     DocumentStatus @default(ready)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type])
  @@map("documents")
}

model PlanChangeRequest {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  requestedBy String                  @map("requested_by") @db.Uuid
  fromPlanId  String                  @map("from_plan_id")
  toPlanId    String                  @map("to_plan_id")
  status      PlanChangeRequestStatus @default(pending)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  requester User   @relation("PlanChangeRequests", fields: [requestedBy], references: [id])

  @@index([tenantId, status])
  @@map("plan_change_requests")
}

model Module {
  id          String   @id
  name        String
  description String?
  defaultUrl  String   @map("default_url")
  active      Boolean  @default(true)
  // Nullable for phase a1 (additive migration); backfilled in a2, tightened to
  // NOT NULL in a follow-up migration once verified (see design Migration/Rollout).
  productId   String?  @map("product_id")
  // Sub-module nesting (1 level max, enforced at application layer)
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product         Product?               @relation(fields: [productId], references: [id])
  parent          Module?                @relation("ModuleChildren", fields: [parentId], references: [id])
  children        Module[]               @relation("ModuleChildren")
  planModules     PlanModule[]
  tenantOverrides TenantModuleOverride[]
  entitlements    Entitlement[]
  roleModuleAccess RoleModuleAccess[]

  @@map("modules")
}

model PlanModule {
  planId   String @map("plan_id")
  moduleId String @map("module_id")
  plan     Plan   @relation(fields: [planId],   references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("plan_modules")
}

model TenantModuleOverride {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id")
  enabled   Boolean
  reason    String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@map("tenant_module_overrides")
}

// The billing-boundary anchor (owner decision #5): one row per tenant per
// product. Plan-derived entitlements are resolved live via
// TenantProductSubscription → Plan → PlanModule — never materialized.
model TenantProductSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  productId String    @map("product_id")
  planId    String    @map("plan_id")
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])

  @@unique([tenantId, productId])
  @@map("tenant_product_subscriptions")
}

// Only non-plan-derived grants are stored here (source: override|trial|admin).
// Plan-derived access is always a live join, never a materialized Entitlement row.
model Entitlement {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  productId String            @map("product_id")
  moduleId  String?           @map("module_id")
  userId    String?           @map("user_id") @db.Uuid
  source    EntitlementSource
  kind      EntitlementKind   @default(grant)
  expiresAt DateTime?         @map("expires_at")
  reason    String?
  createdBy String?           @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  module  Module? @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, productId, moduleId, source])
  @@index([expiresAt])
  @@map("entitlements")
}

model ProductRole {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id")
  key       String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  assignments UserProductRole[]
  moduleAccess RoleModuleAccess[]

  @@unique([productId, key])
  @@map("product_roles")
}

model UserProductRole {
  userId        String   @map("user_id") @db.Uuid
  productRoleId String   @map("product_role_id") @db.Uuid
  assignedBy    String?  @map("assigned_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productRole ProductRole @relation(fields: [productRoleId], references: [id], onDelete: Cascade)

  @@id([userId, productRoleId])
  @@map("user_product_roles")
}

// Phase 2: module-level permissions per product role.
// A role's permitted modules are the union of its RoleModuleAccess rows.
model RoleModuleAccess {
  productRoleId String      @map("product_role_id") @db.Uuid
  moduleId      String      @map("module_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  productRole ProductRole @relation(fields: [productRoleId], references: [id], onDelete: Cascade)
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([productRoleId, moduleId])
  @@map("role_module_access")
}

