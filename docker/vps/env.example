# Copiar a /opt/corehub/<ambiente>/.env y completar.
# Este archivo parametriza compose.vps.yml — no contiene secretos de las apps,
# esos van en env/*.env.

ENV_NAME=dev

# Puertos en 127.0.0.1. DEV usa 411x, PROD usa 410x.
# El rango 30xx esta ocupado por los otros 7 sistemas de la VPS: no usarlo.
PORT_HUB=4111
PORT_API_IAM=4112
PORT_IG_WEB=4113
PORT_IG_API=4114

DOMAIN_IG_API=dev.iga.corehub.guay.pro
DOMAIN_IG_WEB=dev.ig.corehub.guay.pro

IMAGE_PREFIX=ghcr.io/accarbonell1987/instagram-dashboard
IMAGE_TAG=dev-latest

# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=<openssl rand -base64 32>
