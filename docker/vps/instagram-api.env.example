# Copiar a /opt/corehub/<ambiente>/env/instagram-api.env y completar.
#
# DATABASE_URL, PORT, IAM_JWKS_URL e IAM_INTERNAL_URL los inyecta el compose.

CORS_ORIGIN=https://dev.ig.corehub.guay.pro
IAM_JWT_ISSUER=https://dev.api.corehub.guay.pro

# Registrar este callback EXACTO en el panel de Meta. Reemplaza el tunel de
# ngrok: al ser un dominio fijo se registra una vez y no rota mas.
IG_APP_ID=<de developers.meta.com>
IG_APP_SECRET=<de developers.meta.com>
IG_REDIRECT_URI=https://dev.iga.corehub.guay.pro/api/auth/instagram/callback

# openssl rand -hex 32
ENCRYPTION_KEY=<openssl rand -hex 32 — exactamente 64 hex, la config valida el largo>

DEEPSEEK_API_KEY=<la que ya usas>
DEEPSEEK_BASE_URL=<la que ya usas>
DEEPSEEK_MODEL=deepseek-v4-flash

ENABLE_USAGE_TRACKING=true
