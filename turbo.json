{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/**"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "JWT_PRIVATE_KEY_PATH",
    "JWT_PUBLIC_KEY_PATH",
    "JWT_ACTIVE_KID",
    "BANCARD_WEBHOOK_SECRET"
  ],
  "tasks": {
    "tokens:build": {
      "inputs": [
        "tokens/**/*.tokens.json",
        "tokens/build.js"
      ],
      "outputs": [
        "styles/generated/**"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "tokens:build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "src/**"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "!.next/cache/**"
      ],
      "cache": true
    },
    "dev": {
      // Construye las dependencias del workspace antes de levantar nada. Los
      // paquetes que exportan desde dist/ —@core/entitlements— no resuelven sin
      // eso, y dist/ esta en .gitignore: en un clon limpio no existe. Sin esta
      // linea, `pnpm dev` falla con ERR_MODULE_NOT_FOUND en una maquina nueva y
      // funciona en la de quien lo construyo una vez.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "*.config.*"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "__tests__/**",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "outputs": [
        "coverage/**",
        "test-results/**"
      ],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "__tests__/**",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "e2e/**",
        "tests/**",
        "playwright.config.*"
      ],
      "outputs": [
        "test-results/**",
        "playwright-report/**"
      ],
      "cache": false
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tsconfig.json"
      ],
      "cache": true
    },
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "outputs": [
        "node_modules/.prisma/**"
      ],
      "cache": false
    },
    "db:push": {
      "dependsOn": [
        "db:generate"
      ],
      "cache": false
    }
  }
}
